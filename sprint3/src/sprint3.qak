System sprint3

Request loadrequest  : loadrequest(OCCUPIED)                     // fa richiesta di carico, OCCUPIED controlla se l'ingresso è libero o occupato da un container
Reply   loadaccepted : loadaccepted(SLOT,HOLD) for loadrequest    // accetta il carico, assegna lo SLOT e mostra lo stato della HOLD
Reply   loadrejected : loadrejected(REASON,HOLD)   for loadrequest    // rifiuta il carico, dà il motivo (REASON) e mostra lo stato della HOLD

Dispatch pushButton    : pushButton(NONE)          // simula la pressione del pulsante fisico dello IOPort
Dispatch setOccupied   : setOccupied(FLAG)         // il sonar reale invia questo dispatch a ioport (stato "c'è già un container fermo all'IOPort")
Dispatch updateDisplay : updateDisplay(STATE,HOLD,MSG)

Request transportContainer : transportContainer(SLOT,TARGETX,TARGETY)   //cargoservice incarica cargorobot di prelevare il container dall'IOPort, passare da slot5 per la marcatura e depositarlo nello SLOT riservato; TARGETX/TARGETY sono le coordinate dello SLOT, calcolate da Hold (unica fonte del layout della stiva)
Reply   transportDone      : transportDone(SLOT)      for transportContainer
Reply   transportFailed    : transportFailed(CAUSE)   for transportContainer

// FIX marker: ripristinata la request/reply bloccante decisa in Sprint2 (era stata sostituita
// da un generico whenTime 2000 in cargorobot, che perdeva il significato "sto aspettando la
// marcatura" e il relativo tempo dedicato). cargorobot, depositato il container in slot5, resta
// bloccato in attesa che cargoservice segnali la fine della marcatura.
Request waitMarker : waitMarker(NONE)
Reply   markerDone : markerDone(NONE) for waitMarker

// FIX R2: nuovo evento, mancava nel vocabolario. E' quello che permette a cargoservice di sapere
// che il cliente ha davvero posato il container entro i 30s, invece di mandare cargorobot alla
// cieca subito dopo l'accettazione.
Dispatch sonarcontainer : sonarcontainer(DISTANCE)  // sonar -> cargoservice: container rilevato (D < DFREE/2 per >= 3s)

// robotHalted RIMOSSO: era dichiarato e inviato da cargorobot, ma nessuno stato di cargoservice
// lo intercettava — messaggio morto. cargoservice scopre comunque il guasto tramite la reply
// transportFailed alla propria request, che è già gestita.

Request  moverobot      : moverobot(TARGETX, TARGETY, STEPTIME)   //move from current pos to (TARGETX,TARGETY)
Reply    moverobotdone  : moverobotok(ARG)                        for moverobot
Reply    moverobotfailed: moverobotfailed(PLANDONE, PLANTODO)     for moverobot

Event    sonarreading  : sonarreading(DISTANCE)   // letture continue iniettate da SonarMqttAdapter
Dispatch sonarfault    : sonarfault(CAUSE)        // D > DFREE per >= 3s: sospetto guasto sonar
Dispatch sonarrestored : sonarrestored(NONE)      // sonar tornato a D <= DFREE dopo un guasto
Dispatch blinkLed      : blinkLed(FLAG)           // comando Led per il PicoW, inoltrato via MQTT
Dispatch halt          : halt(X)                  // arresto immediato verso RobotSmart26

Context ctxcargoservice ip [host="localhost" port=8050]   // per cargoservice, cargorobot, ioport e sonar
Context ctxrobotsmart   ip [host="127.0.0.1"  port=8020]

ExternalQActor robotsmart context ctxrobotsmart

QActor cargoservice context ctxcargoservice
    withobj hold using "utils.cargoservice.Hold()" {

    [# var Slot = -1
     var TX = -1
     var TY = -1
     var Occupied = false
     hold.setAllSlotsFree() #]

    State idle initial {
    	[#var Stato = hold.displayStatus().toString() #]
    	println("$Stato") color magenta
        println("$name | idle, in attesa di richieste...") color magenta
    }
    Transition t0
        whenRequest loadrequest -> handleRequest
        whenMsg sonarfault      -> idleOutOfService
        whenMsg sonarrestored   -> idleServiceRestored

    // FIX R4: idle poteva ricevere un guasto/ripristino sonar senza che il display lo mostrasse
    // mai. Stesso pattern duplicato (piccolo handler + Goto diretto) già usato altrove nel file,
    // es. in cargorobot per onSonarFault sui vari leg del tragitto.
    State idleOutOfService {
        onMsg(sonarfault : sonarfault(CAUSE)) {
            [# var H = "'" + hold.displayStatus() + "'" #]
            [# var S = "'OUT_OF_SERVICE'" #]
            [# var M = "'Out of service'" #]
            println("$name | sonar guasto, aggiorno display") color red
            forward ioport -m updateDisplay : updateDisplay($S,$H,$M)
        }
    }
    Goto idle

    State idleServiceRestored {
        onMsg(sonarrestored : sonarrestored(NONE)) {
            [# var H = "'" + hold.displayStatus() + "'" #]
            [# var S = "'IDLE'" #]
            [# var M = "'Service working'" #]
            println("$name | sonar ripristinato, aggiorno display") color magenta
            forward ioport -m updateDisplay : updateDisplay($S,$H,$M)
        }
    }
    Goto idle

    State handleRequest {
        onMsg(loadrequest : loadrequest(X)) {
            [# Occupied = payloadArg(0).toBoolean() #]
            [# var H = "'" + hold.displayStatus() + "'" #]
            if [# Occupied == true #] {
                replyTo loadrequest with loadrejected : loadrejected(retrylater,$H)
            } else {
                [# Slot = hold.reserveFirstFree() #]
                if [# Slot != -1 #] {
                    [# TX = hold.slotX(Slot)
                       TY = hold.slotY(Slot)
                       var H2 = "'" + hold.displayStatus() + "'" #]
                    println("$name | richiesta accettata (hold=$H2)") color magenta
                    replyTo loadrequest with loadaccepted : loadaccepted($Slot,$H2)
                } else {
                    replyTo loadrequest with loadrejected : loadrejected(full,$H)
                }
            }
        }
    }
    Goto engaged if [# Slot != -1 && Occupied == false #] else idle

    // FIX R2: prima questo stato mandava subito transportContainer a cargorobot, senza aspettare
    // che il cliente avesse davvero posato il container. Ora si limita ad attendere: o arriva
    // sonarcontainer (il cliente ha portato il container in tempo) o scadono i 30s (R2).
    State engaged {
	    println("$name | engaged, in attesa che il cliente porti il container (slot $Slot)") color magenta
	    forward sonar -m blinkLed : blinkLed(true)
	}
	Transition t0
	    whenTime 30000           -> disengagedTimeout
	    whenMsg sonarcontainer   -> startTransport
	    whenRequest loadrequest  -> rejectBusyContainer
	    whenMsg sonarfault       -> engagedOutOfService
	    whenMsg sonarrestored    -> engagedServiceRestored

	State rejectBusyContainer {
	    onMsg(loadrequest : loadrequest(X)) {
	        [# var H = "'" + hold.displayStatus() + "'" #]
	        println("$name | sistema occupato, rifiuto nuova richiesta") color magenta
	        replyTo loadrequest with loadrejected : loadrejected(retrylater,$H)
	    }
	}
	Goto engaged

	State engagedOutOfService {
	    onMsg(sonarfault : sonarfault(CAUSE)) {
	        [# var H = "'" + hold.displayStatus() + "'" #]
	        [# var S = "'OUT_OF_SERVICE'" #]
	        [# var M = "'Out of service'" #]
	        forward ioport -m updateDisplay : updateDisplay($S,$H,$M)
	    }
	}
	Goto engaged

	State engagedServiceRestored {
	    onMsg(sonarrestored : sonarrestored(NONE)) {
	        [# var H = "'" + hold.displayStatus() + "'" #]
	        [# var S = "'ENGAGED'" #]
	        [# var M = "'Service working'" #]
	        forward ioport -m updateDisplay : updateDisplay($S,$H,$M)
	    }
	}
	Goto engaged

	// FIX R2 (parte 2): qui parte davvero il trasporto, solo dopo la conferma del sonar.
	State startTransport {
	    println("$name | container rilevato, incarico cargorobot per slot $Slot (x=$TX,y=$TY)") color magenta
	    request cargorobot -m transportContainer : transportContainer($Slot,$TX,$TY)
	}
	Goto waitingTransport

	// Non c'è più whenTime 30000 qui: quel timeout riguardava l'attesa del container (R2),
	// già consumato nello stato "engaged". Qui si aspetta solo l'esito del trasporto.
	State waitingTransport {
	    // nessuna azione: solo attesa
	}
	Transition t1
	    whenReply transportDone          -> success
	    whenReply transportFailed        -> disengagedFault
	    whenRequest loadrequest          -> rejectBusyTransport
	    whenRequest waitMarker           -> handleMarking
	    whenMsg sonarfault               -> transportOutOfService
	    whenMsg sonarrestored            -> transportServiceRestored

	State rejectBusyTransport {
	    onMsg(loadrequest : loadrequest(X)) {
	        [# var H = "'" + hold.displayStatus() + "'" #]
	        println("$name | sistema occupato, rifiuto nuova richiesta") color magenta
	        replyTo loadrequest with loadrejected : loadrejected(retrylater,$H)
	    }
	}
	Goto waitingTransport

	State transportOutOfService {
	    onMsg(sonarfault : sonarfault(CAUSE)) {
	        [# var H = "'" + hold.displayStatus() + "'" #]
	        [# var S = "'OUT_OF_SERVICE'" #]
	        [# var M = "'Out of service'" #]
	        forward ioport -m updateDisplay : updateDisplay($S,$H,$M)
	    }
	}
	Goto waitingTransport

	State transportServiceRestored {
	    onMsg(sonarrestored : sonarrestored(NONE)) {
	        [# var H = "'" + hold.displayStatus() + "'" #]
	        [# var S = "'ENGAGED'" #]
	        [# var M = "'Service working'" #]
	        forward ioport -m updateDisplay : updateDisplay($S,$H,$M)
	    }
	}
	Goto waitingTransport

	// FIX marker: la marcatura torna a essere un'attesa temporizzata dentro cargoservice
	// (Sprint2), invece di un whenTime generico dentro cargorobot. La durata (3s) è un
	// placeholder: nei requisiti non è quantificata, solo descritta come "qualche secondo".
	State handleMarking {
	    println("$name | marcatura container in corso...") color magenta
	}
	Transition tm whenTime 3000 -> markingDone

	State markingDone {
	    println("$name | marcatura completata, notifico cargorobot") color magenta
	    replyTo waitMarker with markerDone : markerDone(NONE)
	}
	Goto waitingTransport

	// FIX: prima "disengaged" era un unico stato raggiunto sia da timeout sia da guasto, con
	// un messaggio hardcoded sempre uguale ("Timeout scaduto..."), falso in caso di guasto.
	// Ora sono due stati distinti, ciascuno col proprio messaggio corretto.
	State disengagedTimeout {
	    println("$name | timeout scaduto, nessun container arrivato: libero lo slot e torno idle") color magenta
	    [# hold.releaseReserved() #]
	    [# var H = "'" + hold.displayStatus() + "'" #]
	    [# var S = "'IDLE'" #]
	    [# var M = "'Timeout scaduto: slot liberato, torno idle'" #]
	    forward sonar -m blinkLed : blinkLed(false)
	    forward ioport -m updateDisplay : updateDisplay($S,$H,$M)
	    [# Slot = -1 #]
	}
	Goto idle

	State disengagedFault {
	    println("$name | trasporto fallito per guasto robot: libero lo slot e torno idle") color red
	    [# hold.releaseReserved() #]
	    [# var H = "'" + hold.displayStatus() + "'" #]
	    [# var S = "'IDLE'" #]
	    [# var M = "'Guasto durante il trasporto: slot liberato, riprovare'" #]
	    forward sonar -m blinkLed : blinkLed(false)
	    forward ioport -m updateDisplay : updateDisplay($S,$H,$M)
	    [# Slot = -1 #]
	}
	Goto idle

	State success {
		onMsg(transportDone : transportDone(SLOT)) {
            [# Slot = payloadArg(0).toInt()
            	var Done  = hold.setReservedSlotOccupied()
            #]

			println("$name | trasporto del container in slot $Slot terminato, torno idle") color magenta
			[# hold.releaseReserved() #]
	    	[# var H = "'" + hold.displayStatus() + "'" #]
	    	[# var S = "'IDLE'" #]
	    	[# var M = "'Trasporto terminato'" #]
	    	forward sonar -m blinkLed : blinkLed(false)
	    	forward ioport -m updateDisplay : updateDisplay($S,$H,$M)
	    	[# Slot = -1 #]
		}
	}
	Goto idle
}

QActor cargorobot context ctxcargoservice
    withobj hold using "utils.cargoservice.Hold()" {

    [# var TargetSlot = -1
       var TargetX = -1
       var TargetY = -1
       var PendingTX = -1     // target del moverobot in corso, per la ripresa dopo un guasto sonar
       var PendingTY = -1
       var Leg = ""           // "toIOPort" | "toSlot5" | "toReserved" | "toHome"
    #]

    State idle initial {
        println("$name | idle, in attesa di un incarico di trasporto...") color yellow
    }
    Transition t0 whenRequest transportContainer -> startTransport

    State startTransport {
        onMsg(transportContainer : transportContainer(SLOT,TARGETX,TARGETY)) {
            [# TargetSlot = payloadArg(0).toInt()
               TargetX = payloadArg(1).toInt()
               TargetY = payloadArg(2).toInt()
               var IOPort = hold.getIOPortPosition()
               var X_IOPort =  IOPort.getX()
               var Y_IOPort = IOPort.getY()
               PendingTX = X_IOPort ; PendingTY = Y_IOPort ; Leg = "toIOPort"
                #]
            println("$name | incarico ricevuto (slot riservato=$TargetSlot, x=$TargetX,y=$TargetY), vado all'IOPort per il ritiro del container") color yellow
            request robotsmart -m moverobot : moverobot($X_IOPort, $Y_IOPort, 345)
        }
    }
    Transition t1
        whenReply moverobotdone   -> atIOPort
        whenReply moverobotfailed -> halted
        whenMsg   sonarfault      -> onSonarFault

    State atIOPort {
        println("$name | arrivato in IoPort") color yellow
    }
    Transition t2 whenTime 2000 -> goToSlot5
    // NOTA: pausa di assestamento, non un'attesa "significativa" come la marcatura. Il robot
    // qui è già fermo (non in moto), quindi un eventuale sonarfault in questa finestra non
    // richiede un halt verso RobotSmart26: non c'è nessun moverobot in corso da interrompere.
    // Resta un limite noto: se il guasto non si risolve prima del prossimo moverobot,
    // cargorobot parte comunque senza saperlo (si veda nota di chiusura file).

    State goToSlot5 {
    	[# var S5 = hold.getSlot5Position()
               var X_S5 =  S5.getX()
               var Y_S5 = S5.getY()
               PendingTX = X_S5 ; PendingTY = Y_S5 ; Leg = "toSlot5"
        #]
    	println("$name | container ritirato, vado allo slot5 per la marcatura") color yellow
    	request robotsmart -m moverobot : moverobot($X_S5, $Y_S5, 345)
    }
    Transition t3
    	whenReply moverobotdone   -> atSlot5
        whenReply moverobotfailed -> halted
        whenMsg   sonarfault      -> onSonarFault

    // FIX marker: ripristinata la request/reply bloccante verso cargoservice (Sprint2), al posto
    // del generico whenTime 2000 che aveva fatto perdere il significato di questa attesa.
    State atSlot5 {
        println("$name | container depositato in slot5, attendo fine marcatura") color yellow
        request cargoservice -m waitMarker : waitMarker(NONE)
    }
    Transition t4 whenReply markerDone -> goToReservedSlot
    // Nessun sonarfault qui: come per atIOPort/atSlot, il robot è fermo durante la marcatura,
    // non c'è un moverobot in corso da fermare.

    State goToReservedSlot {
        [# PendingTX = TargetX ; PendingTY = TargetY ; Leg = "toReserved" #]
        println("$name | marcatura completata, vado allo slot riservato $TargetSlot") color yellow
        request robotsmart -m moverobot : moverobot($TargetX, $TargetY, 345)
    }
    Transition t5
        whenReply moverobotdone   -> atSlot
        whenReply moverobotfailed -> halted
        whenMsg   sonarfault      -> onSonarFault

    State atSlot {
        println("$name | arrivato allo slot riservato $TargetSlot") color yellow
    }
    Transition t6 whenTime 2000 -> goHome
    // Stessa nota di atIOPort: pausa di assestamento, robot fermo, nessun halt necessario qui.

    State goHome {
        [# var H = hold.getHomePosition()
        	var X_HOME = H.getX()
            var Y_HOME = H.getY()
            PendingTX = X_HOME ; PendingTY = Y_HOME ; Leg = "toHome"
        #]
        println("$name | container depositato, torno in HOME") color yellow
        request robotsmart -m moverobot : moverobot($X_HOME, $Y_HOME, 345)
    }
    Transition t7
        whenReply moverobotdone   -> done
        whenReply moverobotfailed -> halted
        whenMsg   sonarfault      -> onSonarFault

    State done {
        println("$name | HOME raggiunta, trasporto completato") color yellow
        replyTo transportContainer with transportDone : transportDone($TargetSlot)
        [# TargetSlot = -1
           TargetX = -1
           TargetY = -1 #]
    }
    Goto idle

    // FIX: mancava una via d'uscita da questo stato. Senza "Goto idle" cargorobot restava
    // bloccato qui per sempre dopo un guasto RobotSmart26 (moverobotfailed), anche se
    // cargoservice nel frattempo tornava regolarmente operativo: non avrebbe più potuto
    // accettare un nuovo transportContainer.
    // FIX: rimosso anche il forward robotHalted (messaggio morto, nessuno stato di cargoservice
    // lo intercettava): cargoservice scopre comunque il guasto tramite transportFailed, la
    // reply alla propria stessa request.
    State halted {
        println("$name | guasto RobotSmart26 rilevato, mi fermo e attendo decisione") color red
        replyTo transportContainer with transportFailed : transportFailed(guastoRobotSmart26)
        [# TargetSlot = -1
           TargetX = -1
           TargetY = -1 #]
    }
    Goto idle

    State onSonarFault {
        onMsg(sonarfault : sonarfault(CAUSE)) {
            println("$name | sonarfault ricevuto, fermo RobotSmart26 e sospendo verso ($PendingTX,$PendingTY)") color red
            forward robotsmart -m halt : halt(NONE)
        }
    }
    Transition tf whenMsg sonarrestored -> resumeMove

    State resumeMove {
        onMsg(sonarrestored : sonarrestored(NONE)) {
            println("$name | sonarrestored ricevuto, riprendo (leg=$Leg) verso ($PendingTX,$PendingTY)") color yellow
            request robotsmart -m moverobot : moverobot($PendingTX, $PendingTY, 345)
        }
    }
    Transition tr
        whenReply moverobotdone   -> resumedOk
        whenReply moverobotfailed -> halted

    State resumedOk {
        // instrada verso lo stato successivo originale, in base alla tratta interrotta
    }
    Goto atIOPort if [# Leg == "toIOPort" #] else checkResumedSlot5

    State checkResumedSlot5 { }
    Goto atSlot5 if [# Leg == "toSlot5" #] else checkResumedSlot

    State checkResumedSlot { }
    Goto atSlot if [# Leg == "toReserved" #] else done

    // NOTA: halt e' documentato per la famiglia RobotService26 (Dispatch halt : halt(X)),
    // non esplicitamente per RobotSmart26 nella versione del Protobook consultata.
    // Lo adottiamo come ipotesi di lavoro; se RobotSmart26 non lo riconoscesse alla
    // prima prova su banco, l'unico punto da correggere e' il forward in onSonarFault.
    //
    // LIMITE NOTO (non risolto in questa revisione): se un sonarfault si presenta e non si
    // risolve durante una delle pause di assestamento (atIOPort, atSlot, 2000ms), cargorobot
    // può comunque avviare il moverobot successivo ignorando il guasto ancora in corso, perché
    // in quegli stati whenMsg sonarfault non è gestito (il robot è fermo, non c'è nulla da
    // interrompere). Da valutare se serva un controllo esplicito prima di ogni moverobot.
}

QActor ioport context ctxcargoservice
    withobj status using "utils.cargoservice.IOPortStatus()" {

    [# var WsAdapter = utils.cargoservice.IOPortWsAdapter(this, 7070) #]

    State idle initial {
        println("$name | idle, in attesa della pressione del pulsante...") color cyan
    }
    Transition t0
        whenMsg pushButton  -> onButtonPressed
        whenMsg setOccupied -> onSetOccupied
        whenMsg   updateDisplay -> onUpdateDisplay

    State onButtonPressed {
        onMsg(pushButton : pushButton(X)) {
            println("$name | pulsante premuto, invio richiesta di carico") color cyan
            [# var Occ = status.isOccupied() #]
            request cargoservice -m loadrequest : loadrequest($Occ)
        }
    }
    Transition t1
        whenReply loadaccepted -> showAccepted
        whenReply loadrejected -> showRejected
        whenMsg   updateDisplay -> onUpdateDisplay

    State showAccepted {
        onMsg(loadaccepted : loadaccepted(SLOT,HOLD)) {
        	[# var S = payloadArg(0) #]
        	[# var H = payloadArg(1) #]
            println("$name | display -> richiesta accettata, slot=$S") color cyan
            [# WsAdapter.updateDisplay("ENGAGED", H, "Richiesta accettata - slot " + S) #]
        }
    }
    Goto idle

    State showRejected {
        onMsg(loadrejected : loadrejected(REASON,HOLD)) {
        	[# var R = payloadArg(0) #]
        	[# var H = payloadArg(1) #]
        	println("$name | display -> richiesta rifiutata, reason=$R") color cyan
        	[# WsAdapter.updateDisplay("IDLE", H, "Richiesta rifiutata: " + R) #]
        }
    }
    Goto idle

    State onSetOccupied {
        onMsg(setOccupied : setOccupied(FLAG)) {
        	[# var F = payloadArg(0) #]
        	[# status.setOccupied(F.toBoolean()) #]
            println("$name | sensore IOPort -> occupied=$F") color cyan
        	[# WsAdapter.notifySensor(F) #]
        }
    }
    Goto idle

    State onUpdateDisplay {
        onMsg(updateDisplay : updateDisplay(STATE,HOLD,MSG)) {
        	[# var S = payloadArg(0) #]
        	[# var H = payloadArg(1) #]
        	[# var M = payloadArg(2) #]
        	println("$name | display -> $M") color cyan
        	[# WsAdapter.updateDisplay(S, H, M) #]
        }
    }
    Goto idle
}


QActor sonar context ctxcargoservice {

    [# var DFREE = 30
       var Dist = 0.0
       var Occupied = false
       var Faulted = false
       var T0Container = 0L        // 0 = nessuna finestra di conferma container in corso
       var T0Fault = 0L            // 0 = nessuna finestra di conferma guasto in corso
       var WINDOW = 3000L          // 3 secondi, requisito esplicito di Sprint0
       var MqttLink = utils.cargoservice.SonarMqttAdapter(
		    this,
		    "tcp://localhost:1883",
		    "cargoservice/sonar/distance",
		    "cargoservice/sonar/led"
		)
    #]


    State idle initial {
        println("$name | idle, in ascolto delle letture del PicoW via MQTT...") color blue
    }
    Transition t0
        whenEvent sonarreading -> onReading
        whenMsg blinkLed     -> onBlink

    State onReading {
        onMsg(sonarreading : sonarreading(D)) {
            [# Dist = payloadArg(0).toDouble()
               var Now = System.currentTimeMillis()
            #]

            if [# Dist < DFREE/2.0 #] {
                [# if (T0Container == 0L) { T0Container = Now } #]
                if [# !Occupied && (Now - T0Container) >= WINDOW #] {
                    [# Occupied = true #]
                    println("$name | container rilevato (D=$Dist cm), notifico ioport e cargoservice") color blue
                    forward ioport      -m setOccupied     : setOccupied(true)
                    // FIX R2: mancava questo forward. Senza di esso cargoservice non aveva modo
                    // di sapere che il container era arrivato, e partiva col trasporto alla cieca
                    // subito dopo l'accettazione, invece di aspettare la conferma del sonar.
                    forward cargoservice -m sonarcontainer : sonarcontainer($Dist)
                }
            } else {
                [# T0Container = 0L #]
                if [# Occupied && Dist >= DFREE/2.0 #] {
                    [# Occupied = false #]
                    println("$name | container non piu' rilevato (D=$Dist cm)") color blue
                    forward ioport -m setOccupied : setOccupied(false)
                }
            }

            // --- zona guasto: D > DFREE ---
            if [# Dist > DFREE #] {
                [# if (T0Fault == 0L) { T0Fault = Now } #]
                if [# !Faulted && (Now - T0Fault) >= WINDOW #] {
                    [# Faulted = true #]
                    println("$name | guasto sonar sospetto (D=$Dist cm)") color red
                    forward cargoservice -m sonarfault : sonarfault(sonarOutOfRange)
                    forward cargorobot   -m sonarfault : sonarfault(sonarOutOfRange)
                }
            } else {
                [# T0Fault = 0L #]
                if [# Faulted #] {
                    [# Faulted = false #]
                    println("$name | sonar ripristinato (D=$Dist cm)") color blue
                    forward cargoservice -m sonarrestored : sonarrestored(NONE)
                    forward cargorobot   -m sonarrestored : sonarrestored(NONE)
                }
            }
        }
    }
    Goto idle

    State onBlink {
        onMsg(blinkLed : blinkLed(FLAG)) {
            [# var F = payloadArg(0)
            MqttLink.sendLed(F.toBoolean()) 
            #]
            println("$name | comando Led($F) inoltrato al PicoW via MQTT") color blue
        }
    }
    Goto idle
}
